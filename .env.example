# HybridAI/.env

# OpenAI API (GPT-4 Turbo)
OPENAI_API_KEY=

# DeepSeek API
DEEPSEEK_API_KEY=

# Claude API (Anthropic)
CLAUDE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Collections in DB
NEXT_PUBLIC_HYBRIDAI_DEFAULT_USERS_COLLECTION=users
NEXT_PUBLIC_HYBRIDAI_DEFAULT_CHATS_COLLECTION=chats

# Solana RPC URLs
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_HELIUS_RPC_URL=

# Secret (generated with `openssl rand -base64 32`)
NEXTAUTH_SECRET=

# Google and Twitter (X) authorization API keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
